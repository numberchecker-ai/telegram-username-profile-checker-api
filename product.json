{
  "name": "Telegram Username Profile Checker API",
  "brand": "NumberChecker",
  "repository": "numberchecker-ai/telegram-username-profile-checker-api",
  "description": "Asynchronous bulk Telegram username profile verification API for NumberChecker.",
  "official_site": "https://numberchecker.ai",
  "landing_page": "https://numberchecker.ai/products/telegram-username-profile-checker",
  "canonical_docs": null,
  "base_url": "https://api.numberchecker.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async",
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "format": "text",
    "one_per_line": true,
    "input_kind": "username"
  },
  "products": [
    {
      "type": "tg_username_profile",
      "name": "Profile Checker",
      "min": 500,
      "max": 10000000,
      "fields": [
        "username",
        "activated",
        "avatar_url",
        "uid",
        "lastseen",
        "activedays",
        "member",
        "category",
        "gender",
        "hair_color",
        "skin_color",
        "age"
      ],
      "fields_note": "CSV header read from the current signed-in sample endpoint on 2026-10-30; preserve exact order and duplicate names.",
      "min_billable_numbers": 0,
      "available": true,
      "product_id": 80
    }
  ],
  "pricing_url": "https://numberchecker.ai/pricing",
  "maintainer": "NumberChecker",
  "license": "MIT",
  "last_reviewed": "2026-10-30",
  "documentation_status": "product_specific_hosted_guide_unavailable"
